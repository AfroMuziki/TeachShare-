APP_NAME=TeachShare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (Supabase Postgres). Use the SESSION pooler (port 5432), not 6543.
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require

# Session / cache / queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Google OAuth (Laravel Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Brevo (transactional email via HTTP API, not SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@teachshare.app
BREVO_SENDER_NAME=TeachShare
MAIL_MAILER=log

# Cloudinary (Phase 2 - configured now, unused in Phase 1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Cloudflare Turnstile (optional CAPTCHA, shown after 3 failed sign-ins)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App-specific
TEACHSHARE_ADMIN_EMAIL=admin@teachshare.app
TEACHSHARE_ADMIN_PASSWORD=
